  "cards": [
    {
      "dot": "cyan",
      "title": "异步通道：解耦与双向能力",
      "items": [
        "JSON-RPC 2.0 规范，包含单调递增 ID、超时机制 (默认 30s) 与上下文传递",
        "支持 Native/Flutter 主动向 H5 发起请求 (callH5) 及全局事件广播 (dispatchEvent)"
      ]
    },
    {
      "dot": "amber",
      "title": "同步通道：极致性能与即时性",
      "items": [
        "绕过 Flutter 事件循环与异步 IPC，走原生注入接口直接取值",
        "解决 WebView 初始化时页面首屏强依赖 Token / SafeArea 的白屏等待痛点"
      ]
    },
    {
      "dot": "violet",
      "title": "本地 WS 流：高吞吐媒体与数字人",
      "items": [
        "Rust 驱动的本地 127.0.0.1 闭环服务，完全消除 Base64 / JSON 序列化性能开销",
        "ArrayBuffer 内存所有权直传 (Vec<u8>)，承载音频流、数字人视频帧等大体量双工通信"
      ]
    }
  ]
