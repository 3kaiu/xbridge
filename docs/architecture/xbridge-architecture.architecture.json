  "cards": [
    {
      "dot": "cyan",
      "title": "双态通道架构",
      "items": [
        "Async Bridge: 基于 JSON-RPC 2.0 的异步请求/响应与事件推送，解耦跨端调用（v0.1.4 起为唯一调用通道）",
        "Local WS Server: 本地 127.0.0.1 高性能 WebSocket，二进制帧零序列化全双工传输"
      ]
    },
    {
      "dot": "emerald",
      "title": "多层独立与无业务耦合",
      "items": [
        "H5 层 (@3kaiu/xbridge-js) 支持自动嗅探与降级，提供统一 call 门面",
        "Flutter 层 (xbridge_flutter) 统一路由与生命周期管理，支持反向 H5 调用与事件广播",
        "Native / Rust 模块独立发布 (AAR / CocoaPods / Crates.io)，按需集成"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与异常治理",
      "items": [
        "SecurityPolicy 严格 Origin 白名单与安全泛域名匹配，杜绝非授权页面调用",
        "方法级权限矩阵（Capability-Based ACL），支持公共方法与敏感能力按域名分权",
        "Rust 本地 WS 采用动态一次性 Ticket 握手鉴权 + Loopback-Only 绑定，彻底防御跨进程探测",
        "内置单调时钟与 LRU 状态桶的 BridgeRateLimiter 频控，防止 DoS 与暴力爆破",
        "防风暴聚合结构化安全事件遥测（BridgeSecurityTelemetry）与递归敏感字段脱敏",
        "Fail-Closed 默认闭合策略，全链路异常转换为统一 BridgeError"
      ]
    }
  ]
